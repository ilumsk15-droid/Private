  "interviews": [
    {
      "title": "数字を追うのを\nやめた日",
      "titleEn": "INTERVIEW 01",
      "lead": "登録者八十万人。伸ばし方が分かった瞬間に、彼は全部の動画を消した。その一年間、何をしていたのか。",
      "pullQuote": "型が分かるというのは、実は危険な状態だと思う。",
      "body": {
        "$ref": "@people/minato-haruki/interview-1.md"
      }
    },
    {
      "title": "会社をやると、\n動画が変わる",
      "titleEn": "INTERVIEW 02",
      "lead": "五十八人の給料。四つの事業。作る側に回ってから、彼の言葉は明らかに慎重になった。",
      "pullQuote": "批評する側から、作る側に立場が変わると、言葉が慎重になる。",
      "body": {
        "$ref": "@people/minato-haruki/interview-2.md"
      }
    }
  ],
  "qa": [
    {
      "q": "五年後、動画は続けていますか。",
      "a": "続けています。本数は減っているかもしれないけど、辞める理由が今のところ見当たらない。週二本が週一本になっても、止まってはいないと思います。"
    },
    {
      "q": "会社はどこまで大きくしますか。",
      "a": "人数は増やさないつもりです。五十八人でだいたい限界だと感じている。これ以上増えると、僕が全員の顔と仕事を把握できなくなる。把握できない組織は、僕には運転できません。"
    },
    {
      "q": "海外展開の予定は。",
      "a": "製造の相談は来ています。ただ、動画のほうは翻訳しても本質が伝わらない気がしていて、まだ答えが出ていません。原価の話は国ごとに前提が違いすぎる。"
    },
    {
      "q": "後進の育成についてはどう考えていますか。",
      "a": "LAB FUNDがそれです。教えるより、金を出して失敗させるほうが早い。僕自身がそうやって学んだので。返済が売上連動なのは、失敗を怖がらせたくないからです。"
    },
    {
      "q": "最後に。いま一番作りたいものは何ですか。",
      "a": "自分の工場です。父の工場は畳んでしまったので。金型から製品まで、全部自分たちの手の中でやる。それができたら、たぶん動画の内容もまた変わると思う。"
    }
  ],
  "articles": [
    {
      "title": "登録者ゼロからの三度目",
      "titleEn": "TURNING POINT",
      "lead": "事故、決断、そしてまた事故。三度のゼロが、いまの会社の形をつくった。",
      "pullQuote": "あれがなかったら、いまも広告収益に八割依存していたと思う。",
      "body": {
        "$ref": "@people/minato-haruki/turning-point.md"
      }
    }
  ],
