{
  "name": "the-influencer-magazine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE INFLUENCER - reusable magazine layout & page generation system",
  "scripts": {
    "preview": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview --port 4173 --strictPort",
    "validate": "tsx scripts/validate.ts",
    "validate:layout": "tsx scripts/validate-layout.ts",
    "export:pdf": "tsx scripts/export-pdf.ts --mode=book",
    "export:pages": "tsx scripts/export-pdf.ts --mode=pages",
    "export:spreads": "tsx scripts/export-pdf.ts --mode=spreads",
    "assets:placeholders": "tsx scripts/generate-placeholders.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
